# Text files are stored and checked out with LF on every platform.
* text=auto eol=lf

# Windows batch files need CRLF to run under cmd.exe.
*.bat text eol=crlf

# Goldens are compared byte for byte; never convert their line endings.
**/golden/** -text
**/goldens/** -text
*.golden -text

