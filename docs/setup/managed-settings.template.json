{
  "disableClaudeAiConnectors": true,
  "allowManagedMcpServersOnly": true,
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Edit(//home/spectre/spectre/**)",
      "Edit(//home/spectre/.spectre-agent/**)",
      "Edit(//tmp/**)",
      "Bash(./gradlew *)",
      "Bash(./gradlew)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(adb *)",
      "Bash(python -I *)",
      "Bash(python3 -I *)",
      "Bash(bash tools/*)",
      "Bash(bash scripts/*)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(ln *)",
      "Bash(unzip *)",
      "Bash(zip *)",
      "Bash(tar *)",
      "Bash(gzip *)",
      "Bash(gunzip *)",
      "Bash(sha256sum *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(tr *)",
      "Bash(tee *)",
      "Bash(xargs *)",
      "Bash(export *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(date *)",
      "Bash(apksigner verify *)",
      "Bash(aapt2 dump *)",
      "Bash(zipalign -c *)",
      "WebSearch",
      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:source.android.com)",
      "WebFetch(domain:kotlinlang.org)",
      "WebFetch(domain:docs.gradle.org)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:dagger.dev)",
      "WebFetch(domain:robolectric.org)",
      "WebFetch(domain:www.bluetooth.com)",
      "WebFetch(domain:wiki.openstreetmap.org)",
      "WebFetch(domain:operations.osmfoundation.org)",
      "WebFetch(domain:opendatacommons.org)"
    ],
    "deny": [
      "mcp__*",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --delete *)",
      "Bash(git push --mirror *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(gh release delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh auth token)",
      "Bash(gh auth token *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(claude mcp *)",
      "Edit(//etc/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.claude.json)",
      "Edit(//home/spectre/spectre/.claude/**)",
      "Edit(//home/spectre/spectre/.github/workflows/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "bash /etc/claude-code/spectre/guard.sh" }] },
      { "matcher": "Edit", "hooks": [{ "type": "command", "command": "bash /etc/claude-code/spectre/guard.sh" }] },
      { "matcher": "Write", "hooks": [{ "type": "command", "command": "bash /etc/claude-code/spectre/guard.sh" }] },
      { "matcher": "NotebookEdit", "hooks": [{ "type": "command", "command": "bash /etc/claude-code/spectre/guard.sh" }] }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /etc/claude-code/spectre/statusline.sh",
    "padding": 0,
    "refreshInterval": 30
  }
}
